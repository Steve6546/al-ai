# ═══════════════════════════════════════════════════════════════════════════
# AL AI — environment template
#
#   cp .env.example .env        then fill in Section 1. Nothing else is needed.
#
# Section 1 is what a deployment cannot boot without. Section 2 decides where
# the rows live. Section 3 is tuning: every value there has a working default,
# chosen for a 256 MB container, and leaving it blank means "use the default".
#
# On a managed host (Bot-Hosting, Railway, Render, Pterodactyl) this file is
# NOT read — the panel's environment tab is the source of truth. Use it as the
# checklist of which keys to paste there, in this order.
#
# NEVER commit real values. `npm run check:secrets` fails the commit.
# ═══════════════════════════════════════════════════════════════════════════


# ─── SECTION 1 — CORE REQUIRED (9) ─────────────────────────────────────────
# Each one maps to a named tab in the Discord Developer Portal.

# Bot → Reset Token.
BOT_TOKEN=

# OAuth2 → Client ID and Client Secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# OAuth2 → Redirects. Must equal ONE registered entry exactly: same scheme,
# same host, no trailing slash. Any difference is `Invalid OAuth2 redirect_uri`.
#   local : http://localhost:3000/auth/discord/callback
#   hosted: https://<your-domain>/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# The public origin members open, and the base of the bot's "open dashboard"
# links. It has to be reachable from a phone, not only from this machine.
DASHBOARD_URL=http://127.0.0.1:3000

# Three secrets, generated separately — never reuse one for another:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   SESSION_SECRET     any string ≥ 32 characters (session cookies)
#   ENCRYPTION_KEY     exactly 64 hex characters (AES-256-GCM at rest)
#   EVENT_HMAC_SECRET  signs the bot → dashboard health snapshots
SESSION_SECRET=
EVENT_HMAC_SECRET=
ENCRYPTION_KEY=

# Your Discord user id. Gates the deployment-wide surfaces (network reach, the
# bot's global identity) that belong to the deployment rather than to a guild.
# Unset = denied for everyone; the dashboard logs a warning at first use.
OWNER_ID=


# ─── SECTION 2 — DATABASE MODE (1) ─────────────────────────────────────────
# Blank → `boot.sh` starts the built-in PostgreSQL inside `.al-ai-pg`, applies
#         the schema and exports DATABASE_URL itself. Right for Bot-Hosting,
#         Docker and any single-slot host: no second service, no network hop.
# Set   → used verbatim, and no local database starts. Right for Supabase,
#         Neon, Railway, RDS or an existing server.
#
# `npm run dev` on a workstation does NOT go through boot.sh, so it needs the
# commented line below uncommented — the local cluster listens on 55432.
DATABASE_URL=
# DATABASE_URL=postgresql://al_ai:change_me@localhost:55432/al_ai

# The owner connection used by `npm run db:export` / `db:import`: the one
# identity that may read and restore the whole database, kept apart from the
# application's least-privilege role on purpose. `boot.sh` exports it under this
# name; a workstation can leave it blank and the exporter falls back to
# DATABASE_URL, then to the embedded cluster's printed URL.
AL_AI_ADMIN_DATABASE_URL=


# ─── SECTION 3 — ADVANCED & AUTO-TUNED DEFAULTS ────────────────────────────
# Nothing below is required to boot. Blank means "use the default".

# --- 3.1 Runtime and process ----------------------------------------------
# "production" turns an undecided operational setting into a startup failure;
# anything else logs it and continues. Docker Compose sets production itself.
NODE_ENV=development
# Port the dashboard BFF listens on. Default 3000.
PORT=3000
# Where the bot pushes its signed health snapshots. Defaults to DASHBOARD_URL;
# loopback keeps internal telemetry off the public tunnel.
DASHBOARD_INTERNAL_URL=http://127.0.0.1:3000
# Single-instance lock. The bot refuses a second copy on the same volume.
BOT_LOCK_FILE=.al-ai-bot.lock
# Tooling only. `scripts/test-runner.mjs` rewrites this for every test worker
# from the machine's free memory; setting it by hand is overridden.
NODE_OPTIONS=

# --- 3.2 Retention — REQUIRED when NODE_ENV=production ---------------------
# The application never guesses a retention policy, so production refuses to
# boot without both. Keep them equal to what the panel has, so there is one
# number and not two.
KEY_ROTATION_DAYS=90
AUDIT_RETENTION_DAYS=90

# --- 3.3 Embedded PostgreSQL (only when DATABASE_URL is blank) ------------
# Undefined is the normal case: the defaults put the cluster in
# <repo>/.al-ai-pg and listen on 5432. Set POSTGRES_PASSWORD rather than these
# unless the platform forces a different port or directory.
POSTGRES_PASSWORD=change_me
# The role the services connect as, and its own password. Never leave the
# services on the owner role: `boot.sh` mints `password-app` on first use and
# hands the dashboard and bot the least-privilege URL (DML only, NOBYPASSRLS).
# A managed provider that gives you one role keeps using it; the warning in the
# boot log says so.
AL_AI_PG_APP_USER=al_ai_app
POSTGRES_APP_PASSWORD=
# The workstation cluster's host port, and the port `npm run dev` expects.
POSTGRES_HOST_PORT=55432
AL_AI_PG_HOME=
AL_AI_PG_USER=al_ai
AL_AI_PG_DATABASE=al_ai
PGDATA=
PGPORT=

# --- 3.4 Backup and restore (scripts/db-export.mjs, db-import.mjs) --------
# The repository root. `boot.sh` exports it; the bundles in host-build/ are
# flattened, so `import.meta.url` no longer points at the source tree.
AL_AI_ROOT=
# Where snapshots are written and read from. Default <repo>/.al-ai-host/backups.
AL_AI_BACKUP_DIR=
# How many snapshots to keep; older ones and their .sha256 sidecars are removed
# after each export. Default 5.
AL_AI_BACKUP_KEEP=
# Rows per INSERT during a restore. The import streams the snapshot, so this
# bounds one statement only. Default 500.
AL_AI_IMPORT_BATCH=

# --- 3.5 Memory ceilings (MB of V8 old space) -----------------------------
# A ceiling is not a reservation: it makes V8 collect instead of letting the
# heap grow until the cgroup OOM-kills the container. Defaults 96 / 80 / 24,
# sized from the measured steady state on a 256 MB plan.
AL_AI_HEAP_BOT=
AL_AI_HEAP_DASHBOARD=
AL_AI_HEAP_PG=

# --- 3.6 Log growth caps (boot.sh) ---------------------------------------
# Each service log is truncated in place once it passes this size, keeping the
# last AL_AI_LOG_KEEP_LINES lines as `<name>.log.1`. Defaults 5 MiB / 400.
# This is what stops a crash loop from filling the disk.
AL_AI_LOG_MAX_BYTES=
AL_AI_LOG_KEEP_LINES=
# Where boot.sh writes each service log, and where it keeps the setup
# fingerprint and the database snapshots. Defaults: <repo>/.al-ai-host/logs
# and <repo>/.al-ai-host. Set them only when the volume layout differs.
AL_AI_LOG_DIR=
AL_AI_HOST_STATE=

# --- 3.7 Public reach ----------------------------------------------------
# The hostname a managed platform publishes this deployment at. Such a platform
# terminates TLS and forwards from its own network, so the peer is never
# loopback and the Host gate would refuse every visit. Leave empty on a
# self-hosted machine, where loopback/LAN/tunnel remain the only sources.
AL_AI_PLATFORM_HOST=
# One-process override for the reach mode, used by scripts/dev.ps1:
#   off  loopback only (the `npm run dev` default) · lan  also this machine's
#   private addresses · on  force the public ngrok tunnel. Nothing is saved;
#   the dashboard switch stays the only thing that persists a mode.
AL_AI_REMOTE_ACCESS=
# The fixed ngrok hostname for a stable public URL, e.g. name.ngrok-free.dev.
# A boot default only; the network screen writes the saved value.
NGROK_DOMAIN=
# Path to the ngrok binary when it is not on PATH. The dashboard reads the
# agent's loopback API on 127.0.0.1:4040 for liveness — keep that port free.
NGROK_PATH=

# Loopback relay, used by scripts/run-linux-stack.sh on a platform that
# publishes the app on its own port: the relay connects over loopback and
# presents AL_AI_TUNNEL_HOST, which the reach gate then accepts.
# AL_AI_RELAY_LISTEN_PORTS is a comma-separated list (several published ports
# cost one relay process); AL_AI_RELAY_LISTEN_PORT is the older single-port
# spelling and still works. All three unset = no relay, the normal local run.
AL_AI_RELAY_LISTEN_PORTS=
AL_AI_RELAY_LISTEN_PORT=
AL_AI_TUNNEL_HOST=

# --- 3.8 Optional integrations -------------------------------------------
# Webhook that receives every security.* event (always critical). Unset means
# those events are still written to the audit trail, just delivered nowhere.
DEVELOPER_WEBHOOK_URL=
# Integration adapter (GOVERNANCE rule 16). Binds to 127.0.0.1 only; unset
# keeps it off, "true" exposes the local control surface.
INTEGRATION_ADAPTER_ENABLED=

# --- 3.9 Workstation tooling only ---------------------------------------
# Points `npm run check:schema` at an out-of-tree toolchain install.
AL_AI_TOOLCHAIN=
# The browser scripts/ui-check.mjs drives. Unset looks for Chrome, then Edge.
CHROME_PATH=
# One re-encryption run (scripts/rotate-encryption-key.mts). Both 64 hex chars.
ENCRYPTION_KEY_OLD=
ENCRYPTION_KEY_NEW=
# --- 3.10 CI and the portable launcher ----------------------------------
# `npm start` (scripts/start.mjs, the Linux/macOS/VPS launcher) sizes each Node
# child from these. Defaults 512 (dashboard) and 2048 (bot) are generous on
# purpose: that launcher is for machines that are not the 256 MB container.
AL_AI_DASHBOARD_HEAP_MB=
AL_AI_BOT_HEAP_MB=
# `scripts/test-runner.mjs` picks worker count and heap from free memory; pin
# them only for reproducible CI. Both are clamped to the safe range, so a bad
# value cannot exhaust the machine.
AL_AI_TEST_CONCURRENCY=
AL_AI_TEST_HEAP_MB=
