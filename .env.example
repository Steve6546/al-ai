# AL AI runtime secrets template.
# Copy this file to .env and fill in real values. NEVER commit real values here.
# The bot intentionally refuses to connect while BOT_TOKEN is empty.

# Runtime mode. "production" turns an undecided operational setting into a
# startup failure; anything else — including unset, the local default — logs it
# and continues. Docker Compose sets it to production for both services.
NODE_ENV=development

# Tooling only. `scripts/test-runner.mjs` inherits and rewrites this to cap the
# V8 heap of every test worker; leave it unset so the runner can choose a safe
# value from the machine's free memory. Setting it by hand is overridden.
NODE_OPTIONS=

BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# The local (non-Docker) stack: the project's own PostgreSQL runs on 55432, and
# both values below have to agree - the port in DATABASE_URL and
# POSTGRES_HOST_PORT are read by different parts of the code, and a mismatch
# means the services connect to one port while the tooling checks another.
# The Compose default is 5432; use it only when you run the database through
# infra/docker-compose.yml, and change both lines together.
DATABASE_URL=postgresql://al_ai:change_me@localhost:55432/al_ai
POSTGRES_PASSWORD=change_me
POSTGRES_HOST_PORT=55432

# Host-only (scripts/host/pg.mjs, the embedded database on a one-slot platform).
# Undefined is the normal case: the defaults put everything inside
# <repo>/.al-ai-pg and listen on 5432. Set POSTGRES_PASSWORD instead of editing
# these unless the platform forces a different port or directory. When
# DATABASE_URL is set, boot.sh starts no embedded database at all.
AL_AI_PG_HOME=
AL_AI_PG_USER=al_ai
AL_AI_PG_DATABASE=al_ai
PGDATA=
PGPORT=

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
EVENT_HMAC_SECRET=
ENCRYPTION_KEY=

# Mandatory operational settings: NODE_ENV=production refuses to boot without
# them. The application never guesses a retention policy — these are example
# values for a fresh deployment, so choose your own before going live and keep
# them consistent with your compliance requirements.
KEY_ROTATION_DAYS=90
AUDIT_RETENTION_DAYS=365

# Where the bot links members and pushes its signed health snapshots. Set the
# public HTTPS origin when the ngrok tunnel is the primary entry point, so
# `/settings` and `/dashboard` replies work from any device.
DASHBOARD_URL=http://127.0.0.1:3000

# Optional. Where the bot pushes its signed health snapshots. Defaults to
# DASHBOARD_URL; set the loopback address to keep internal telemetry off the
# public tunnel.
DASHBOARD_INTERNAL_URL=http://127.0.0.1:3000

# Port the dashboard BFF listens on. Default 3000.
PORT=3000

# Optional. Webhook that receives the internal "developer" destination: every
# security.* event, which is always critical. Unset means those events are still
# written to the audit trail, but delivered nowhere.
DEVELOPER_WEBHOOK_URL=

# Integration adapter (GOVERNANCE rule 16). Binds to 127.0.0.1 only.
# Leave unset to keep it off; set to "true" to expose the local control surface.
INTEGRATION_ADAPTER_ENABLED=

# Optional. Path to the single-instance lock file.
BOT_LOCK_FILE=.al-ai-bot.lock

# Optional, tooling only. Points `npm run check:schema` at an out-of-tree
# toolchain install when this repository's node_modules is not available.
AL_AI_TOOLCHAIN=

# Optional. The fixed ngrok hostname used for a stable public URL, e.g.
# name.ngrok-free.dev. The same value can be set from the network screen and
# stored in instance_settings; this variable is just a boot default. The free
# plan includes one dev domain; a second agent on the same hostname fails.
NGROK_DOMAIN=

# Optional. Path to the ngrok binary when it is not on PATH. ngrok's own config
# file (%LOCALAPPDATA%\ngrok\ngrok.yml) carries the account authtoken.
# The dashboard reads the agent's loopback inspection API on 127.0.0.1:4040
# (/api/status and /api/tunnels) for tunnel liveness and the live public URL.
# Keep that port free and local: it is the zero-quota alternative to probing
# the public address, and a second ngrok agent on this machine would take it.
NGROK_PATH=

# Optional. One-process override for the reach mode, used by the local
# bootstrapper (scripts/dev.ps1). Values:
#   off   loopback only (the `npm run dev` default: no quick-tunnel URL is
#         minted on every start)
#   lan   also answer this machine's private addresses — devices on the same
#         Wi-Fi/router reach http://<LAN_IP>:<PORT>. No tunnel, no ngrok quota.
#   on    force the public ngrok tunnel (same as "tunnel")
# Neither is saved — the switch in the dashboard remains the only thing that
# persists a mode. Leave unset to honour the operator's saved choice.
# `npm run dev -- -Lan` sets "lan" for one run; `npm start` honours this value
# or the saved setting. The BFF always binds 0.0.0.0 — this flag controls its
# Host gate, not the socket.
AL_AI_REMOTE_ACCESS=

# Optional. The hostname a managed platform publishes this deployment at, e.g.
# a1b2c3d4e5.apps.example.cloud. Such a platform terminates TLS and forwards to
# the container port from its own network, so the request's TCP peer is never
# loopback and the Host gate would refuse every visit. Setting this value makes
# exactly that one hostname accepted from any peer; leave it empty for a
# self-hosted machine, where loopback/LAN/tunnel remain the only accepted
# sources. Ports are still checked, so a foreign port on the same hostname is
# refused.
AL_AI_PLATFORM_HOST=

# Maintenance only (scripts/rotate-encryption-key.mts): the old and new key for
# one re-encryption run. Both must be 64 hex characters; never commit real keys.
ENCRYPTION_KEY_OLD=
ENCRYPTION_KEY_NEW=

# The platform owner's Discord user id. Gates the deployment-wide surfaces
# (network reach, the bot's global identity) that belong to the deployment,
# not to any single guild. Leave unset to deny those features for everyone
# (the dashboard logs a warning at first use). The value is never sent to the
# client �?" the session endpoint publishes only the yes/no verdict.
OWNER_ID=

# Optional. The browser the visual check (scripts/ui-check.mjs) drives. Left
# unset, it looks for Chrome and then Edge in their standard locations; set it
# to point at a specific binary when several are installed.
CHROME_PATH=
