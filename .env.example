# AL AI runtime secrets template.
# Copy this file to .env and fill in real values. NEVER commit real values here.
# The bot intentionally refuses to connect while BOT_TOKEN is empty.

# Runtime mode. "production" turns an undecided operational setting into a
# startup failure; anything else — including unset, the local default — logs it
# and continues. Docker Compose sets it to production for both services.
NODE_ENV=development

BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# The local (non-Docker) stack: the project's own PostgreSQL runs on 55432, and
# both values below have to agree - the port in DATABASE_URL and
# POSTGRES_HOST_PORT are read by different parts of the code, and a mismatch
# means the services connect to one port while the tooling checks another.
# The Compose default is 5432; use it only when you run the database through
# infra/docker-compose.yml, and change both lines together.
DATABASE_URL=postgresql://al_ai:change_me@localhost:55432/al_ai
POSTGRES_PASSWORD=change_me
POSTGRES_HOST_PORT=55432

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
EVENT_HMAC_SECRET=
ENCRYPTION_KEY=

# Mandatory operational settings: must be set before any production deploy.
# Never guess these values.
KEY_ROTATION_DAYS=
AUDIT_RETENTION_DAYS=

# Where the bot pushes its signed health snapshots.
DASHBOARD_URL=http://127.0.0.1:3000

# Port the dashboard BFF listens on. Default 3000.
PORT=3000

# Optional. Webhook that receives the internal "developer" destination: every
# security.* event, which is always critical. Unset means those events are still
# written to the audit trail, but delivered nowhere.
DEVELOPER_WEBHOOK_URL=

# Integration adapter (GOVERNANCE rule 16). Binds to 127.0.0.1 only.
# Leave unset to keep it off; set to "true" to expose the local control surface.
INTEGRATION_ADAPTER_ENABLED=

# Optional. Path to the single-instance lock file.
BOT_LOCK_FILE=.al-ai-bot.lock

# Optional, tooling only. Points `npm run check:schema` at an out-of-tree
# toolchain install when this repository's node_modules is not available.
AL_AI_TOOLCHAIN=

# Optional. Where the remote-access tunnel finds the cloudflared binary. Leave
# unset to use the standard install locations; needed only when cloudflared
# lives somewhere unusual.
CLOUDFLARED_PATH=

# Production tunnel (recommended over the quick tunnel for anything durable).
# Create a remotely-managed tunnel in the Cloudflare dashboard, route a fixed
# hostname to it, then set both values. CLOUDFLARED_HOSTNAME is what the OAuth
# callback and the reach gate use, so the Developer Portal redirect is
# registered once and never changes.
CLOUDFLARED_TUNNEL_TOKEN=
CLOUDFLARED_HOSTNAME=

# Optional. One-process override for the reach mode, used by the local
# bootstrapper (scripts/dev.ps1). "off" forces loopback-only for this run
# (the default for `npm run dev`, so no rotating quick-tunnel URL is minted on
# every start); "on" forces the tunnel on. Neither is saved — the switch in the
# dashboard remains the only thing that persists a mode. Leave unset to honour
# the operator's saved choice.
AL_AI_REMOTE_ACCESS=

# Maintenance only (scripts/rotate-encryption-key.mts): the old and new key for
# one re-encryption run. Both must be 64 hex characters; never commit real keys.
ENCRYPTION_KEY_OLD=
ENCRYPTION_KEY_NEW=

# The platform owner's Discord user id. Gates the deployment-wide surfaces
# (network reach, the bot's global identity) that belong to the deployment,
# not to any single guild. Leave unset to deny those features for everyone
# (the dashboard logs a warning at first use). The value is never sent to the
# client �?" the session endpoint publishes only the yes/no verdict.
OWNER_ID=

# Optional. The browser the visual check (scripts/ui-check.mjs) drives. Left
# unset, it looks for Chrome and then Edge in their standard locations; set it
# to point at a specific binary when several are installed.
CHROME_PATH=
