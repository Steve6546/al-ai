{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/*.mts"],
      "project": ["scripts/**/*.mjs", "scripts/**/*.mts"],
      "ignore": ["scripts/linux/port-forward.mjs"],
      "ignoreDependencies": ["pg"]
    },
    "apps/bot": {
      "entry": [
        "src/lib/discord.ts",
        "scripts/**/*.ts",
        "test/**/*.ts",
        "test/fixtures/*.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "apps/dashboard": {
      "entry": [
        "src/App.tsx",
        "src/index.css",
        "test/**/*.ts",
        "test/**/*.tsx"
      ],
      "project": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.css", "server/**/*.ts", "test/**/*.ts", "test/**/*.tsx"],
      "ignore": ["src/components/ui/**"]
    },
    "packages/core": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["tsx"]
    }
  },
  "ignoreDependencies": [
    "pgsql-ast-parser"
  ],
  "ignoreBinaries": [
    "tasklist",
    "tsx",
    "pgrep"
  ],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false
}
