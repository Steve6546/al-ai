{
  "name": "al-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:stop": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/dev.ps1 -Action stop",
    "dev:restart": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/dev.ps1 -Action restart",
    "dev:status": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/dev.ps1 -Action status",
    "db:start": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/postgres.ps1 -Action start",
    "db:stop": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/postgres.ps1 -Action stop",
    "db:status": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/postgres.ps1 -Action status",
    "db:verify": "node --env-file=.env scripts/verify-db.mjs",
    "dev:dashboard": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/dev.ps1 -NoBot",
    "dev:bot": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/dev.ps1 -NoDashboard",
    "dev:ui": "npm run dev --workspace=@al-ai/dashboard",
    "build": "npm run build --workspaces --if-present",
    "build:host": "node scripts/build-host.mjs",
    "start": "node scripts/start.mjs",
    "host:setup": "bash scripts/host/setup.sh",
    "host:boot": "bash scripts/host/boot.sh",
    "host:db": "node scripts/host/pg.mjs",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:schema": "node scripts/parse-schema.mjs infra/schema.sql",
    "check:secrets": "node scripts/check-secrets.mjs",
    "setup:hooks": "git config core.hooksPath scripts/git-hooks",
    "hooks:off": "git config --unset core.hooksPath",
    "check:dead": "knip",
    "check:ui": "npm run build --workspace=@al-ai/dashboard && node scripts/ui-check.mjs",
    "check:ui:live": "node scripts/ui-check.mjs --live",
    "check:oauth": "node scripts/oauth-check.mjs",
    "check:oauth:preflight": "node --env-file=.env scripts/oauth-preflight.mjs",
    "check:2fa": "node --env-file=.env scripts/two-factor-check.mts",
    "check:load": "node scripts/load-check.mjs",
    "verify": "npm run lint && npm run check:schema && npm test && npm run build && npm run check:secrets && npm run audit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "backup": "node --env-file=.env scripts/backup-db.mjs",
    "db:export": "node scripts/db-export.mjs",
    "db:import": "node scripts/db-import.mjs",
    "deploy": "node --env-file=.env scripts/deploy.mjs",
    "secrets:rotate": "node --env-file=.env scripts/rotate-secrets.mjs",
    "keys:rotate": "node --env-file=.env scripts/rotate-encryption-key.mts",
    "dev:session": "tsx --env-file=.env scripts/dev-issue-session.mts",
    "ui:pull": "node scripts/pull-shadcn.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "knip": "^6.42.1",
    "pgsql-ast-parser": "^12.0.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
